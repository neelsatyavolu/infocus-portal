{
  // infocus-portal: the Portal (this Next.js app, built by OpenNext) on Cloudflare Workers.
  // Served by zone routes added in the dashboard, never a Custom Domain (workers/meeting-room/README.md).
  // Secrets are the same env vars as docs/ENVIRONMENT.md, set with `wrangler secret bulk`; never committed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infocus-portal",
  // worker.ts wraps the OpenNext build (.open-next/worker.js) and adds the cron and queue consumer below.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "infocus-portal" }],
  // Pooled connection to the Portal's Postgres (src/lib/prisma-workers.ts). The id is not a credential.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ed1d440dbd764d159d1e6071f2c51435" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "infocus-portal-next-cache" }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
  // Matches the longest maxDuration in the app (300 s).
  "limits": { "cpu_ms": 300000 },
  // Always run next to the database (Supabase, AWS us-west-1), as the sfo1 pin did on Vercel.
  // Free-plan traffic can land in a far data center (Marseille on Oct 15, 2026); Smart Placement
  // left the Worker there, so every query crossed the Atlantic. Pinned, a page pays one long hop.
  "placement": { "mode": "targeted", "region": "aws:us-west-1" },
  "observability": { "enabled": true },
  // Every minute: meeting reminders and upkeep (worker.ts). Replaces the two every-minute Inngest functions.
  "triggers": { "crons": ["* * * * *"] },
  // Show → YouTube uploads (worker.ts queue handler; each run queues the next, no cron). One show at a time; each run gets up to 15 minutes.
  "queues": {
    "producers": [{ "binding": "SHOW_UPLOADS", "queue": "infocus-show-uploads" }],
    "consumers": [{ "queue": "infocus-show-uploads", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 10 }]
  },
  // Keep the workers.dev test address alongside the routes.
  "workers_dev": true,
  // Both Portal domains (src/lib/hosts.ts): infocusportal.com is canonical; infocuspaly.com stays for
  // installed apps and old links. Removing a route takes that host off the Worker.
  "routes": [
    { "pattern": "infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "www.infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "meet.infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "grades.infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "equipment.infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "teleprompter.infocusportal.com/*", "zone_name": "infocusportal.com" },
    { "pattern": "infocuspaly.com/*", "zone_name": "infocuspaly.com" },
    { "pattern": "meet.infocuspaly.com/*", "zone_name": "infocuspaly.com" },
    { "pattern": "grades.infocuspaly.com/*", "zone_name": "infocuspaly.com" },
    { "pattern": "equipment.infocuspaly.com/*", "zone_name": "infocuspaly.com" },
    { "pattern": "teleprompter.infocuspaly.com/*", "zone_name": "infocuspaly.com" }
  ]
}
