# Workers static assets (wrangler.jsonc "assets"). Build output under /_next/static has content
# hashes in its file names, so browsers can keep it for a year without checking back.
# Never add sw.js or meet-e2ee-worker.js here: they must stay fresh.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, brand images and the meeting media files keep their names when they change, so they get
# one day, then are served while the browser checks for a newer copy.
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/live/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/show-roles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
